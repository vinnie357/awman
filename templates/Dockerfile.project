FROM debian:bookworm-slim

LABEL dev.awman.startup-gate="1"

# System packages required for building, testing, and running this project.
# Add language runtimes, compilers, and tool dependencies here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    curl \
    make \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN /usr/bin/python3 -I -S -c \
    'import errno, grp, hashlib, json, os, pwd, secrets, stat, sys, time; from collections import namedtuple; from pathlib import Path'

WORKDIR /workspace
