FROM awman-awman:latest

# Force root for installation: a base image may have switched to a non-root
# user, and apt/cp/install need write access to /usr/local, /etc, /root.
USER root

# Reset env vars so installer behavior does not depend on what the base set:
#   - HOME drives where installers and tools write user-scoped files.
#   - DEBIAN_FRONTEND avoids interactive apt prompts.
#   - PATH prepends the agent baseline to whatever the base image set,
#     so installer-resolved binaries cannot be shadowed by the base while
#     useful base PATH additions (e.g. /usr/local/cargo/bin from
#     Dockerfile.dev) stay visible inside the agent container.
ENV HOME=/root \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
WORKDIR /root

# Strict shell for every RUN: -e fails fast, -o pipefail catches errors in
# `curl | bash` pipelines so a partial download cannot silently succeed.
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# Override any inherited ENTRYPOINT/CMD so `docker run image <command> ...`
# behaves predictably regardless of how the base evolves.
ENTRYPOINT []
CMD ["/bin/bash"]

# ── Runtime prerequisites ─────────────────────────────────────────────────────
# Codex sandboxes command execution on Linux with bubblewrap and treats it as a
# hard prerequisite; without the `bwrap` binary on PATH, sandboxed exec fails.
# The codex app-server daemon's pid backend calls `ps` (procps) to record its
# process. The base image ships neither, so install both here (as root, before
# dropping to the runtime user) and prune apt lists to keep the layer small.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap procps \
    && rm -rf /var/lib/apt/lists/*

# ── Install agent binary ──────────────────────────────────────────────────────
# Codex CLI is installed via OpenAI's official installer into a shared package
# root. Codex locates its package by canonicalizing its own executable and
# expecting `<pkg>/bin/codex` next to `<pkg>/codex-package.json`; the app-server
# daemon refuses to start without that layout. So the binary must NOT be copied
# out of the package: keep the installer's /usr/local/bin/codex symlink, which
# resolves back into /opt/codex/packages/standalone/current/bin/codex.
#
# CODEX_HOME is set only for the installer. At runtime it stays default
# (~/.codex) so auth and config live in the user's home. The package tree is
# made world-readable so the runtime `awman` user can resolve it.
#
# The installer also unpacks a `codex-code-mode-host` helper but only links it
# on macOS. Link it onto PATH here when present so PATH callers find it too.
RUN curl -fsSL --retry 5 --retry-delay 2 --retry-max-time 120 \
        https://chatgpt.com/codex/install.sh \
        | CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin sh \
    && chmod -R a+rX /opt/codex \
    && test -L /usr/local/bin/codex \
    && host=/opt/codex/packages/standalone/current/bin/codex-code-mode-host \
    && if [ -e "$host" ]; then ln -sf "$host" /usr/local/bin/codex-code-mode-host; fi

# ── awman user + workspace (idempotent against a base that already created it) ─
# Outer braces keep the && chain associated with the user-creation block,
# avoiding the `A || B && C && D` precedence trap that would otherwise skip
# `mkdir`/`chown` whenever the user already exists.
RUN { id -u awman >/dev/null 2>&1 \
       || useradd -m -s /bin/bash -d /home/awman awman 2>/dev/null \
       || useradd -s /bin/bash -d /home/awman awman ; } \
    && mkdir -p /workspace /home/awman \
    && chown -R awman:awman /workspace /home/awman

USER awman
ENV HOME=/home/awman \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
WORKDIR /workspace

# ── Smoke test: run as the runtime user so we verify the binary is on PATH and
# executable from the actual entrypoint context, not just for root. ───────────
# The package-layout check mirrors what codex itself requires at daemon start.
RUN test -x "$(command -v codex)" \
    && test -x "$(command -v bwrap)" \
    && test -x "$(command -v codex-code-mode-host)" \
    && { p="$(readlink -f "$(command -v codex)")"; [ "$(basename "$(dirname "$p")")" = bin ] && test -r "$(dirname "$p")/../codex-package.json"; }
